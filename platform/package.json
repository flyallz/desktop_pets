{
  "name": "desktop-pets-platform",
  "version": "0.5.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Local-first desktop pet maker and companion",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "api": "node server/local-api.mjs",
    "desktop": "npm run build && electron .",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:win": "npm run build && electron-builder --win zip --x64",
    "pack:mac": "npm run build && electron-builder --mac zip --universal",
    "check": "npm test && npm run build"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "io.desktop-pets.companion",
    "productName": "Desktop Pets Beta",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "zip"
      ],
      "icon": "../assets/cat.ico"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "identity": null,
      "minimumSystemVersion": "13.0.0",
      "mergeASARs": true,
      "icon": "public/demo/cat.png"
    },
    "artifactName": "DesktopPets-${version}-${os}-${arch}.${ext}"
  }
}

<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="22" Background="#FAF8F3">
<Grid.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="MinHeight" Value="35"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D7D4CC"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,0,15,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#3D3A36"/></Style>
  <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#F0EDE7"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,40,40"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#E7E3DB"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,20,20"/><RectangleGeometry Rect="20,20,20,20"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
</Grid.Resources>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,17"><TextBlock Text="把照片变成会动的桌宠" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="1  选择照片、自动去背景     2  标记小动作     3  保存到桌面" Margin="0,9,0,0" Foreground="#65615A"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
<Border Background="#E7E3DB" BorderBrush="#D7D4CC" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
  <Grid><ScrollViewer x:Name="PhotoScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,43,0,0"><Viewbox x:Name="PhotoBox" Stretch="Uniform" Margin="8"><Canvas x:Name="DrawingCanvas" Width="953" Height="1347" Background="{StaticResource Checker}" ClipToBounds="True"/></Viewbox></ScrollViewer>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,7,10,0"><Button x:Name="ZoomIn" Content="放大 ＋" Padding="9,3" MinHeight="28"/><Button x:Name="ZoomOut" Content="缩小 －" Padding="9,3" MinHeight="28"/><Button x:Name="ZoomFit" Content="看全图" Padding="9,3" MinHeight="28"/></StackPanel>
  <TextBlock x:Name="EmptyHint" Text="先选一张主体清晰的猫咪照片。&#x0a;照片只在这台电脑处理。" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="16" Margin="20" IsHitTestVisible="False"/>
  <Border x:Name="BusyOverlay" Background="#EAF9F7F2" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" Margin="30"><TextBlock x:Name="BusyText" Text="正在处理……" TextAlignment="Center" FontSize="16"/><ProgressBar IsIndeterminate="True" Height="5" Margin="0,20,0,15"/><Button x:Name="StopProcessing" Content="取消这次处理" HorizontalAlignment="Center"/></StackPanel></Border>
  </Grid>
</Border>
<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="照片" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/><Button x:Name="ChoosePhoto" Content="选择照片 · JPG / PNG" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
  <TextBlock Text="给这个造型起个名字" Margin="0,3,0,6"/><TextBox x:Name="LookName" Text="我的猫咪" MaxLength="32" Padding="9" Margin="0,0,0,18"/>
  <StackPanel x:Name="EditingControls" IsEnabled="False">
  <TextBlock Text="标记想动的部位" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <WrapPanel><RadioButton x:Name="EyeTool" GroupName="Tool" Content="眼睛" IsChecked="True"/><RadioButton x:Name="TailTool" GroupName="Tool" Content="尾巴"/><RadioButton x:Name="EarTool" GroupName="Tool" Content="耳朵"/></WrapPanel>
  <TextBlock x:Name="ToolHint" MinHeight="55" Text="沿一只眼睛，从一侧眼角拖到另一侧。两只眼睛分别画；闭着眼可跳过。" FontSize="12" Foreground="#686158" Margin="0,0,0,8"/>
  <StackPanel x:Name="EyeRange"><TextBlock Text="眼睛张开高度" FontSize="12"/><Slider x:Name="EyeHeight" Minimum="0.25" Maximum="1" Value="0.6" Margin="0,6,0,9" ToolTip="让椭圆覆盖眼睛，尽量不要盖到鼻子"/></StackPanel>
  <StackPanel x:Name="TailRange" Visibility="Collapsed"><TextBlock Text="尾巴粗细" FontSize="12"/><Slider x:Name="TailSize" Minimum="0.12" Maximum="0.6" Value="0.24" Margin="0,6,0,9"/></StackPanel>
  <TextBlock x:Name="MarkCount" Text="眼睛 0 / 2 · 尾巴 0 / 1 · 耳朵 0 / 2" FontSize="12" Margin="0,0,0,8"/>
  <Button x:Name="ClearMarks" Content="清除这类标记" HorizontalAlignment="Left"/>
  <Border BorderBrush="#DDD8CF" BorderThickness="0,1,0,0" Margin="0,10,0,14"/>
  <TextBlock Text="背景有残留？擦一擦就好" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <WrapPanel><RadioButton x:Name="EraseTool" GroupName="Tool" Content="擦掉"/><RadioButton x:Name="RestoreTool" GroupName="Tool" Content="恢复"/><Button x:Name="UndoBrush" Content="撤销" Padding="10,3" MinHeight="25"/></WrapPanel>
  <StackPanel x:Name="BrushRange" Visibility="Collapsed"><TextBlock Text="画笔大小" FontSize="12"/><Slider x:Name="BrushSize" Minimum="12" Maximum="140" Value="55" Margin="0,6,0,10"/></StackPanel>
  <Button x:Name="TogglePreview" Content="▶ 看看它动起来" Background="#246B5E" Foreground="White" BorderThickness="0" Margin="0,12,0,7"/>
  <TextBlock Text="不标记也可以保存，会轻轻呼吸。自行添加的照片会原地陪伴，不会切换成内置猫咪的走路画面。" FontSize="12" Foreground="#716A60" Margin="0,3,0,0"/>
  </StackPanel>
</StackPanel></ScrollViewer>
</Grid>
<Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock x:Name="Status" Text="支持普通 JPG 和 PNG；透明 PNG 可直接使用。" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="12"/>
<StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelEdit" Content="取消" Margin="0,0,8,0"/><Button x:Name="SavePhoto" Content="保存并用这个造型" IsEnabled="False" Background="#246B5E" Foreground="White" BorderThickness="0" Margin="0"/></StackPanel>
</Grid>
</Grid>
